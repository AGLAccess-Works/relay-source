      </StackPanel></ScrollViewer></TabItem>
<TabItem Header="Pointer"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26"><StackPanel>

<Grid x:Name="PointerWorkbench"><Grid.ColumnDefinitions><ColumnDefinition x:Name="PointerFirstColumn"/><ColumnDefinition x:Name="PointerSecondColumn"/><ColumnDefinition x:Name="PointerThirdColumn"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="PointerFirstRow" Height="Auto"/><RowDefinition x:Name="PointerSecondRow" Height="Auto"/><RowDefinition x:Name="PointerThirdRow" Height="Auto"/></Grid.RowDefinitions>

<StackPanel x:Name="PointerDeadZonePane" Margin="0,0,22,0"><TextBlock Text="Stop pointer drift" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="A dead zone ignores tiny stick movements. Increase it if your pointer moves when the stick is at rest." Style="{StaticResource Caption}" Margin="0,8,0,12"/><local:PointerPlot x:Name="DeadZonePlot" Height="210" Mode="DeadZone" AutomationProperties.Name="Live left-stick position and dead zone"/>

<Grid Margin="0,16,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Dead zone size" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="DeadZoneValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="DeadZoneSlider" Minimum="5" Maximum="40" TickFrequency="1" SmallChange="1" LargeChange="4" ValueChanged="SettingChanged" AutomationProperties.Name="Dead zone size" Margin="0,10,0,12"/>

<Border Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="14" Margin="0,12,0,0"><TextBlock Text="Increase this if your pointer drifts at rest. The outer ring is full stick travel; the inner ring is half. The dot shows your stick, and the shaded centre ignores small movements." Style="{StaticResource Caption}"/></Border></StackPanel>

<Border x:Name="PointerResponsePane" Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,1,0" Padding="22,0"><StackPanel><TextBlock Text="Speed and response" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="How fast the pointer moves for how far you push. The dot shows your current movement." Style="{StaticResource Caption}" Margin="0,8,0,12"/><local:PointerPlot x:Name="ResponsePlot" Height="210" Mode="Response" AutomationProperties.Name="Pointer response curve"/>

<Grid Margin="0,16,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Pointer speed" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="SpeedValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="SpeedSlider" Minimum="200" Maximum="2600" TickFrequency="50" SmallChange="50" LargeChange="200" ValueChanged="SettingChanged" AutomationProperties.Name="Pointer speed" Margin="0,10,0,12"/><Grid Margin="0,16,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Response curve" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="CurveValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="CurveSlider" Minimum="100" Maximum="300" TickFrequency="5" SmallChange="5" LargeChange="20" ValueChanged="SettingChanged" AutomationProperties.Name="Response curve" Margin="0,10,0,12"/>

<TextBlock Text="A higher curve makes small movements gentler." Style="{StaticResource Caption}"/></StackPanel></Border>

<StackPanel x:Name="PointerFinePane" Grid.Column="2" Margin="22,0,0,0"><TextBlock Text="Fine movement" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A precision mapping gives 28% pointer speed while held; a speed boost mapping gives 180%. Assign either in Mapping." Style="{StaticResource Caption}" Margin="0,8,0,20"/>

<Grid Margin="0,16,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Motion smoothing" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="SmoothingValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="SmoothingSlider" Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="20" ValueChanged="SettingChanged" AutomationProperties.Name="Motion smoothing" Margin="0,10,0,12"/>

<TextBlock Text="A little damping softens movement. More adds delay; neutral always stops the pointer." Style="{StaticResource Caption}" Margin="0,0,0,22"/>

<TextBlock Text="Start with a preset" FontSize="16" FontWeight="SemiBold"/><UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="Precise" Tag="Precise" Click="ApplyPreset" Margin="0,0,8,8"/><Button Content="Balanced" Tag="Balanced" Click="ApplyPreset" Margin="0,0,0,8"/><Button Content="Quick" Tag="Quick" Click="ApplyPreset" Margin="0,0,8,8"/><Button Content="Steady hands" Tag="Steady" Click="ApplyPreset" Margin="0,0,0,8"/></UniformGrid>

<Button Content="Stabilization &amp; target assistance →" Click="OpenAssist" Margin="0,12,0,0" Padding="8,10"/></StackPanel>

</Grid>

<StackPanel Margin="0,28,0,14"><TextBlock Text="Try it" Style="{StaticResource SectionHeading}"/><TextBlock Text="Move to each target and use your left-click mapping. Changes apply straight away." Style="{StaticResource Caption}" Margin="0,0,0,12"/><WrapPanel><TextBlock x:Name="PracticeScore" Text="0 of 5 targets hit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,8" AutomationProperties.LiveSetting="Polite"/><Button Content="Start again" Click="ResetPractice" VerticalAlignment="Center" Margin="0,0,0,8"/></WrapPanel></StackPanel>

<Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="20"><UniformGrid x:Name="PracticeTargets" Columns="5" Height="200">

<StackPanel Margin="0,10,0,0"><Button Width="64" Height="64" Tag="64" Style="{StaticResource PracticeTarget}" Click="HitPracticeTarget" AutomationProperties.Name="Large practice target 64 pixels"/><TextBlock Text="Large · 64 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><StackPanel Margin="0,75,0,0"><Button Width="48" Height="48" Tag="48" Style="{StaticResource PracticeTarget}" Click="HitPracticeTarget" AutomationProperties.Name="Medium practice target 48 pixels"/><TextBlock Text="Medium · 48 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><StackPanel Margin="0,5,0,0"><Button Width="44" Height="44" Tag="36" Style="{StaticResource PracticeTarget}" Click="HitPracticeTarget" AutomationProperties.Name="Small practice target 36 pixels"/><TextBlock Text="Small · 36 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><StackPanel Margin="0,88,0,0"><Button Width="44" Height="44" Tag="28" Style="{StaticResource PracticeTarget}" Click="HitPracticeTarget" AutomationProperties.Name="Smaller practice target 28 pixels"/><TextBlock Text="Smaller · 28 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><StackPanel Margin="0,38,0,0"><Button Width="44" Height="44" Tag="20" Style="{StaticResource PracticeTarget}" Click="HitPracticeTarget" AutomationProperties.Name="Tiny practice target 20 pixels"/><TextBlock Text="Tiny · 20 px" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel>

</UniformGrid></Border>

</StackPanel></ScrollViewer></TabItem>

<TabItem Header="Steady &amp; targets">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26"><StackPanel>

     <TextBlock Text="Movement assistance" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Reduce shake, soften small movements, and approach targets with confidence." Style="{StaticResource Caption}" Margin="0,8,0,23"/>

     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>

      <TextBlock Text="Learn my movement" FontSize="20" FontWeight="SemiBold"/>

      <TextBlock Text="Relay can learn how your stick moves and soften small adjustments. Learning starts after several seconds of movement and continues across clicks and pauses. It cannot tell which movements were mistakes." Style="{StaticResource Caption}" Margin="0,8,0,12"/>

      <ComboBox x:Name="MotionLearningCombo" AutomationProperties.Name="Motion learning mode" SelectionChanged="MotionLearningChanged" HorizontalAlignment="Stretch" MinWidth="44"><ComboBoxItem Content="Off — use my manual settings"/><ComboBoxItem Content="Learn — adapt as I use Relay"/><ComboBoxItem Content="Frozen — keep current adjustments"/></ComboBox>

      <TextBlock x:Name="MotionSummary" Style="{StaticResource Caption}" Margin="0,12,0,8"/>

      <TextBlock Text="Adds at most 40 ms of smoothing and 15% slowdown for fine motion. Full-speed movements, clicking, dragging and scrolling are excluded. Nothing clicks or undoes actions for you. Only aggregate motion statistics are saved locally; no screen text or keystrokes." Style="{StaticResource Caption}"/>

      <Button Content="Forget learned movement" Click="ForgetMotion" HorizontalAlignment="Left" Margin="0,12,0,0"/>

      <TextBlock x:Name="MotionNotice" Style="{StaticResource Caption}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>

     </StackPanel></Border>

     <Grid x:Name="AssistanceWorkbench"><Grid.ColumnDefinitions><ColumnDefinition x:Name="AssistanceFirstColumn"/><ColumnDefinition Width="20"/><ColumnDefinition x:Name="AssistanceSecondColumn"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="AssistanceFirstRow" Height="Auto"/><RowDefinition x:Name="AssistanceSecondRow" Height="Auto"/></Grid.RowDefinitions><Border x:Name="AssistanceMotionPane" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>

      <TextBlock Text="Steady motion" FontSize="20" FontWeight="SemiBold"/>

