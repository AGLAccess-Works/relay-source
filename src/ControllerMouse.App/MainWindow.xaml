<TextBlock Text="Preferences" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Preferences stay on this PC. No account required." Style="{StaticResource Caption}" Margin="0,0,0,22"/>

<Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Guided setup" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Choose the accessibility help you want. Relay assigns the shortcuts and creates a new profile for you." Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="Set up Relay for me" Click="OpenSetup" HorizontalAlignment="Left" MinHeight="48"/></StackPanel></Border>

<Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="LightThemeCheck" Content="Use the light appearance" Checked="OptionChanged" Unchecked="OptionChanged"/><TextBlock Text="Interface size" Margin="0,16,0,8"/><ComboBox x:Name="ZoomCombo" SelectionChanged="ZoomChanged" AutomationProperties.Name="Interface size" Width="180" HorizontalAlignment="Left"><ComboBoxItem Content="100%"/><ComboBoxItem Content="125%"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="175%"/><ComboBoxItem Content="200%"/></ComboBox><TextBlock Text="Ctrl + plus or minus changes interface size. Ctrl + 0 resets it. Larger text reflows the controls. Scroll down to reach every setting." Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="Open Visual Access" Tag="3" Click="Navigate" AutomationProperties.Name="Open Visual Access" AutomationProperties.AutomationId="SettingsOpenVisualAccess" HorizontalAlignment="Left" Margin="0,0,0,12"/><TextBlock Text="Choose a display scheme, text size, spacing and a simpler view in Accessibility. Windows contrast colours take priority when high contrast is enabled." Style="{StaticResource Caption}"/></StackPanel></Border>

<Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Everyday preferences" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="TrayCheck" Content="Keep running in the tray when the window closes" Checked="OptionChanged" Unchecked="OptionChanged"/><CheckBox x:Name="StartupCheck" Content="Start quietly when I sign in to Windows" Checked="StartupChanged" Unchecked="StartupChanged"/></StackPanel></Border>

<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Local settings" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Restore defaults resets the active profile, appearance and tray preference. Other profiles remain available. Learned target choices can be cleared separately in Assistance." Style="{StaticResource Caption}" Margin="0,10,0,18"/><WrapPanel><Button Content="Restore default settings" Click="RestoreDefaults" Margin="0,0,12,10"/><Button Content="Open local app data" Click="OpenDataFolder" Margin="0,0,12,10"/><Button Content="Quit Relay" Click="Quit" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border>

</StackPanel></ScrollViewer></TabItem><TabItem Header="Profiles"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26"><StackPanel>

 <TextBlock Text="A profile remembers your buttons, accessories and movement settings. Choose a ready-made profile or keep different setups for different tasks. Changes save automatically." Style="{StaticResource Caption}" Margin="0,0,0,26"/>

 <Grid x:Name="ProfilesWorkbench"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ProfilesListColumn" Width="330"/><ColumnDefinition Width="24"/><ColumnDefinition x:Name="ProfilesEditorColumn"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="ProfilesListRow" Height="Auto"/><RowDefinition x:Name="ProfilesEditorRow" Height="Auto"/></Grid.RowDefinitions>

  <StackPanel x:Name="ProfilesListPane"><TextBlock Text="Your profiles" Style="{StaticResource SectionHeading}"/><StackPanel x:Name="ProfileList" AutomationProperties.Name="Saved profiles"/><Button Content="Create a profile from this setup" Click="DuplicateProfile" Margin="0,12,0,0"/></StackPanel>

  <Border x:Name="ProfilesEditorPane" Grid.Column="2" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0"><StackPanel>

   <TextBlock Text="Profile name" FontWeight="SemiBold"/><TextBox x:Name="ProfileName" MaxLength="60" AutomationProperties.Name="Profile name" Margin="0,8,0,12"/>

   <WrapPanel><Button Content="Rename" Click="RenameProfile" Margin="0,0,10,10"/><Button Content="Copy as new profile" Click="DuplicateProfile" Margin="0,0,10,10"/></WrapPanel>

   <TextBlock Text="Each profile stores movement, scrolling, assistance, feedback and button assignments. Appearance and startup are shared." Style="{StaticResource Caption}" Margin="0,12,0,24"/>

   <TextBlock Text="Accessibility starter profiles" FontWeight="SemiBold"/><ComboBox x:Name="StarterProfile" DisplayMemberPath="Name" SelectionChanged="StarterProfileChanged" AutomationProperties.Name="Accessibility starter profile" Margin="0,8,0,12"/><TextBlock x:Name="StarterDescription" Style="{StaticResource Caption}" Margin="0,0,0,12"/><Button Content="Add starter profile" Click="AddStarterProfile" HorizontalAlignment="Left" Margin="0,0,0,24"/><TextBlock Text="Share or back up" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button Content="Import profile…" Click="ImportProfile" Margin="0,0,10,10"/><Button Content="Export profile…" Click="ExportProfile" Margin="0,0,0,10"/></WrapPanel>

   <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20,0,0"><Button x:Name="DeleteProfileButton" Content="Delete this profile…" Click="DeleteProfile" HorizontalAlignment="Left"/></Border>

   <TextBlock x:Name="ProfileNotice" Style="{StaticResource Caption}" Margin="0,20,0,0" AutomationProperties.LiveSetting="Polite"/>

  </StackPanel></Border>

 </Grid>

</StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Hardware"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><StackPanel>

       <Grid x:Name="HardwareWorkbench"><Grid.ColumnDefinitions><ColumnDefinition x:Name="HardwareVisualColumn"/><ColumnDefinition Width="24"/><ColumnDefinition x:Name="HardwareInspectorColumn" Width="330"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="HardwareVisualRow" Height="Auto"/><RowDefinition x:Name="HardwareInspectorRow" Height="Auto"/></Grid.RowDefinitions>
        <StackPanel x:Name="HardwareVisualPane"><WrapPanel x:Name="HardwareViewsHost" Margin="0,0,0,8"/><StackPanel x:Name="HardwareSimpleHost" Visibility="Collapsed"/><local:NavigationGroupPresenter AutomationProperties.Name="Hardware inputs"><local:ControllerSurface x:Name="HardwareSurface" MinHeight="390" AutomationProperties.Name="Controller hardware and adaptive inputs"/></local:NavigationGroupPresenter></StackPanel>
        <Border x:Name="HardwareInspectorPane" Grid.Column="2" Background="Transparent" VerticalAlignment="Top"><StackPanel>
         <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel x:Name="HardwareDeviceHost"/></Border>
         <Expander x:Name="HardwareInputDetails" Header="Selected input" IsExpanded="False" Margin="0,12,0,0"><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel x:Name="HardwareInspectorHost"/></Border></Expander>
        </StackPanel></Border>
       </Grid>
       <TextBlock Text="Inputs" Style="{StaticResource SectionHeading}" Margin="0,24,0,12"/><local:NavigationGroupPresenter AutomationProperties.Name="Saved input assignments"><WrapPanel x:Name="HardwareInputsHost"/></local:NavigationGroupPresenter>
       <TextBlock Text="Adaptive accessory names are saved with your profile. Input activity does not confirm which physical sockets are plugged in." Style="{StaticResource Caption}" Margin="0,16,0,16"/>
       <Button Content="Identify or name an accessory" Click="OpenAccessories" AutomationProperties.Name="Identify and name an Adaptive accessory" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="About"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><StackPanel>
       <TextBlock Text="Relay" Style="{StaticResource SectionHeading}"/><TextBlock Text="by AGL Access Works" Margin="0,0,0,16"/>
       <TextBlock Text="Use the controls that work for you to make Windows respond." Margin="0,0,0,16"/>
       <TextBlock x:Name="AboutVersionText" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
       <TextBlock Text="Your preferences are saved on this PC. No Relay account is needed." Style="{StaticResource Caption}" Margin="0,0,0,20"/>
       <Button Content="Open Accessibility" Tag="3" Click="Navigate" HorizontalAlignment="Left" AutomationProperties.Name="Open Accessibility" AutomationProperties.AutomationId="AboutOpenAccessibility" Margin="0,0,0,12"/>
       <Button Content="Read Relay help" Tag="4" Click="Navigate" HorizontalAlignment="Left" AutomationProperties.Name="Read Relay help" AutomationProperties.AutomationId="AboutOpenHelp"/>
      </StackPanel></ScrollViewer></TabItem>
     </TabControl>
    </ScrollViewer>
   </Grid>
  </Grid>
  <Border x:Name="FooterPanel" Grid.Row="2" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,6"><TextBlock x:Name="Footer" Text="Settings saved on this PC" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/></Border>
 </Grid>
</Window>
