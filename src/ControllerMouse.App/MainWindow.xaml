        <TextBlock Text="{Binding Text, ElementName=StatusTitle}" FontSize="{DynamicResource SectionFontSize}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock x:Name="DisconnectedInstructionText" Text="{Binding Text, ElementName=StatusDetail}" Style="{StaticResource Caption}" TextAlignment="Center" MaxWidth="500" HorizontalAlignment="Center" Margin="0,0,0,20"/>
