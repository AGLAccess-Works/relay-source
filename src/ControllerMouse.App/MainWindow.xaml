     <WrapPanel Margin="0,0,0,18"><Button Content="Change my setup" Click="OpenSetup" Style="{StaticResource Primary}" AutomationProperties.Name="Change my setup" AutomationProperties.AutomationId="HelpChangeSetup" Margin="0,0,12,8"/><Button Content="Make Relay easier to see" Tag="3" Click="Navigate" Margin="0,0,0,8"/></WrapPanel>

     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid x:Name="ControlGuide"/></Border>

     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="A smooth start" FontSize="19" FontWeight="SemiBold"/>

      <TextBlock Text="1. Connect your controller using a connection that works in Windows.&#xA;2. Let go of its buttons, switches and sticks.&#xA;3. Choose Change my setup. Select your controls and the reading or movement help you want." Margin="0,13,0,12" LineHeight="27"/>

      <TextBlock Text="Use your precision mapping for fine movement. Pause before playing games. Close the window to keep control running in the tray, or choose Quit app to stop completely." Style="{StaticResource Caption}"/>

     </StackPanel></Border>

     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="You're always in control" FontSize="19" FontWeight="SemiBold"/>

      <TextBlock Text="Stabilization and target assist are optional and may need adjustment for your movement. The app does not diagnose or treat tremor. Windows protects administrator windows and sign-in screens from simulated input; use your physical keyboard or mouse there." Style="{StaticResource Caption}" Margin="0,12,0,14"/>

      <TextBlock Text="Magnifier follows the cursor when Follow mouse pointer is enabled in Windows Magnifier settings. Ctrl + Alt + P pauses this app without taking Magnifier's Ctrl + Alt + M shortcut." Style="{StaticResource Caption}" Margin="0,0,0,14"/>

      <Button Content="Open local app data" Click="OpenDataFolder" HorizontalAlignment="Left"/>

      <TextBlock Text="No account or cloud connection. Not affiliated with Microsoft or Xbox." Style="{StaticResource Caption}" Margin="0,16,0,0"/>

     </StackPanel></Border>

    </StackPanel></ScrollViewer>

   </TabItem>

<TabItem Header="Scroll &amp; feedback">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26"><StackPanel>

     <TextBlock Text="Scrolling and feedback" FontSize="24" FontWeight="SemiBold"/>

     <TextBlock Text="Set a comfortable reading speed and choose the cues that help you." Style="{StaticResource Caption}" Margin="0,8,0,23"/>

     <Grid x:Name="ScrollingWorkbench"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ScrollingFirstColumn"/><ColumnDefinition Width="20"/><ColumnDefinition x:Name="ScrollingSecondColumn"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="ScrollingFirstRow" Height="Auto"/><RowDefinition x:Name="ScrollingSecondRow" Height="Auto"/></Grid.RowDefinitions><Border x:Name="ScrollSettingsPane" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>

      <TextBlock Text="Right-stick scrolling" FontSize="20" FontWeight="SemiBold"/>

      <ComboBox x:Name="ScrollModeCombo" DisplayMemberPath="Name" SelectedValuePath="Mode" SelectionChanged="MappingChanged" AutomationProperties.Name="Scroll mode" Margin="0,16,0,10"/>

      <TextBlock Text="Smooth sends small wheel increments. Compatible sends full notches for apps that need them. Step gives one notch per nudge, then repeats when held. Apps control the final scrolling animation." Style="{StaticResource Caption}"/>

      <Grid Margin="0,15,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Maximum scroll speed" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="ScrollValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="ScrollSlider" Minimum="1" Maximum="24" SmallChange="1" LargeChange="10" ValueChanged="SettingChanged" AutomationProperties.Name="Maximum scroll speed" Margin="0,10,0,12"/>

      <Grid Margin="0,15,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Right-stick dead zone" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="ScrollDeadZoneValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="ScrollDeadZoneSlider" Minimum="5" Maximum="40" SmallChange="1" LargeChange="10" ValueChanged="SettingChanged" AutomationProperties.Name="Right-stick dead zone" Margin="0,10,0,12"/>

      <Grid Margin="0,15,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Scroll response curve" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="ScrollCurveValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="ScrollCurveSlider" Minimum="100" Maximum="300" SmallChange="1" LargeChange="10" ValueChanged="SettingChanged" AutomationProperties.Name="Scroll response curve" Margin="0,10,0,12"/>

      <Grid Margin="0,15,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Scroll damping" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="ScrollSmoothingValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="ScrollSmoothingSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="10" ValueChanged="SettingChanged" AutomationProperties.Name="Scroll damping" Margin="0,10,0,12"/>

      <CheckBox x:Name="ScrollAxisLockCheck" Content="Prefer one scroll direction at a time" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="ScrollStabilizationCheck" Content="Extra damping for unsteady right-stick movement" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="ScrollModifiersCheck" Content="Use precision and speed boost mappings for scrolling too" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="ScrollPrecisionCheck" Content="Keep precise scrolling on without holding a button" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="InvertCheck" Content="Reverse scroll direction" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <TextBlock Text="Returning the stick to rest stops scrolling immediately. Extra damping may add delay; adjust it to suit your movement." Style="{StaticResource Caption}" Margin="0,10,0,0"/>

     </StackPanel></Border>

     <Border x:Name="FeedbackSettingsPane" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>

      <TextBlock Text="Your controller and feedback" FontSize="20" FontWeight="SemiBold"/>

      <TextBlock Text="Brief, optional cues. Start softly and choose only the cues that help." Style="{StaticResource Caption}" Margin="0,8,0,12"/>

      <TextBlock Text="Your controller" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="ControllerModelText" TextWrapping="Wrap" Margin="0,8,0,8"/>
      <ComboBox x:Name="ControllerTypeCombo" AutomationProperties.Name="Controller type" SelectionChanged="MappingChanged" Margin="0,0,0,8"><ComboBoxItem Content="Automatic detection"/><ComboBoxItem Content="Standard Xbox controller"/><ComboBoxItem Content="Xbox Adaptive Controller"/></ComboBox>
      <TextBlock x:Name="ControllerSetupText" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
      <Button Content="Set up Adaptive accessories" Click="OpenAccessories" AutomationProperties.Name="Set up Adaptive accessories" MinHeight="44" Margin="0,0,0,16"/>
      <CheckBox x:Name="NarratorNavigationCheck" Content="Use the D-pad to navigate menus" AutomationProperties.Name="Use the D-pad to navigate menus in Relay and with Narrator" AutomationProperties.HelpText="The D-pad starts menu navigation inside Relay, or in other apps when Narrator is running. RB next, LB previous, A select, B back. Move the left stick to return to mouse control. Turn this off to keep your saved mappings, including Adaptive switch profiles." Checked="OptionChanged" Unchecked="OptionChanged"/>

      <TextBlock Text="Press the D-pad to navigate. LB: previous control. RB: next control. A: select. B: back. Move the left stick to use the mouse again. Button combinations still work." Style="{StaticResource Caption}" Margin="0,8,0,12"/>

      <TextBlock Text="Magnifier: Narrator may say plus or minus because it announces shortcut keys. In Windows Narrator settings (Windows + Ctrl + N), open Have Narrator announce when I type. Adjust character and modifier-key announcements if you prefer less speech." Style="{StaticResource Caption}" Margin="0,0,0,12"/>

      <CheckBox x:Name="HapticsCheck" Content="Enable controller vibration" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <Grid Margin="0,15,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Vibration strength" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="HapticStrengthValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="HapticStrengthSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="SettingChanged" AutomationProperties.Name="Vibration strength" Margin="0,10,0,12"/>

      <CheckBox x:Name="MagnifierHapticsCheck" Content="Confirm Magnifier shortcuts" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="ScrollHapticsCheck" Content="A light pulse when scrolling starts" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="TargetHapticsCheck" Content="A pulse when the pointer settles over a control" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="BoundaryHapticsCheck" Content="A double pulse when a scroll region reaches its end" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <WrapPanel Margin="0,12,0,12">

       <Button Content="Try scroll cue" Tag="Scroll" Click="PreviewHaptic" Margin="0,0,8,8"/>

       <Button Content="Try target cue" Tag="Target" Click="PreviewHaptic" Margin="0,0,8,8"/>

       <Button Content="Try end cue" Tag="Boundary" Click="PreviewHaptic" Margin="0,0,8,8"/>

      </WrapPanel>

      <TextBlock x:Name="NavigationFeedback" Text="Feedback is ready when you are." Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>

      <TextBlock Text="Target and end cues work in the active window when the app exposes accessibility information. Some apps do not support them. End cues require an observed move to the edge; they stay silent if you were already there. No screen text is stored." Style="{StaticResource Caption}" Margin="0,12,0,0"/>

     </StackPanel></Border></Grid>

    </StackPanel></ScrollViewer>

   </TabItem>

