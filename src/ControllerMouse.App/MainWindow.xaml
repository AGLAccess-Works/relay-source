        <Border x:Name="ProfileStatusCard" Style="{StaticResource CompactStatusCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="1"><TextBlock Text="Profile" Style="{StaticResource Caption}"/><TextBlock x:Name="ProfileHeaderText" Text="My desktop" Margin="0,3,0,0"/></StackPanel></Grid></Border>
        <Border x:Name="DeviceStatusCard" Style="{StaticResource CompactStatusCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><local:DecorativeGlyph Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Device" Style="{StaticResource Caption}"/><TextBlock x:Name="DeviceHeaderText" Text="No controller detected" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border>
        <Border x:Name="ConnectionStatusCard" Style="{StaticResource CompactStatusCard}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><local:DecorativeGlyph Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Connection &amp; battery" Style="{StaticResource Caption}"/><TextBlock x:Name="ConnectionHeaderText" Text="Disconnected" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></Border>
       </WrapPanel></Border>
       <Border x:Name="StatusBanner" Visibility="Collapsed"><TextBlock x:Name="StatusTitle" Text="No controller detected" AutomationProperties.LiveSetting="Polite"/></Border>
