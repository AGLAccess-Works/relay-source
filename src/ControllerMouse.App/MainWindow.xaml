    <ScrollViewer x:Name="NavigationViewport" SizeChanged="NavigationRailSizeChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" CanContentScroll="False"><Grid x:Name="NavigationRailLayout" Margin="12,12,12,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0">
