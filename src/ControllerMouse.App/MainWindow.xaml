      <CheckBox x:Name="TremorCheck" Content="Use tremor stabilization" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Stabilization strength" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="StabilizationValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="StabilizationSlider" Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="20" ValueChanged="SettingChanged" AutomationProperties.Name="Stabilization strength" Margin="0,10,0,23"/>

      <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Press confirmation" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="HoldValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><TextBlock Text="Require a held mouse mapping to stay pressed briefly before a click. Release is immediate. View and Menu clicks on release are exempt." Style="{StaticResource Caption}" Margin="0,3,0,0"/><Slider x:Name="HoldSlider" Minimum="0" Maximum="500" TickFrequency="25" SmallChange="25" LargeChange="100" ValueChanged="SettingChanged" AutomationProperties.Name="Press confirmation" Margin="0,10,0,23"/>

      <TextBlock Text="Try small adjustments in a familiar app. You can turn stabilization off at any time." Style="{StaticResource Caption}"/>

     </StackPanel></Border>

     <Border x:Name="AssistanceTargetPane" Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>

      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Target assist" FontSize="20" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Preview" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,5,0,0"/></Grid>

      <TextBlock Text="Suggests nearby buttons and links along your movement direction, gently guides your approach, and slows inside the target. You make every click. Moving away releases the assist." Style="{StaticResource Caption}" Margin="0,8,0,10"/>

      <CheckBox x:Name="TargetCheck" Content="Help me approach on-screen targets" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Margin="0,0,12,0" Text="Assistance strength" FontWeight="SemiBold"/><TextBlock Grid.Column="1" x:Name="TargetValue" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider x:Name="TargetSlider" Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" LargeChange="20" ValueChanged="SettingChanged" AutomationProperties.Name="Assistance strength" Margin="0,10,0,23"/>

      <CheckBox x:Name="HintCheck" Content="Show a small ring on the suggested target" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <CheckBox x:Name="RememberCheck" Content="Remember the types of controls I choose" Checked="OptionChanged" Unchecked="OptionChanged"/>

      <TextBlock Text="Learning stays on this PC. Only counts of control types are saved—not screen text, screenshots, or a browsing history." Style="{StaticResource Caption}" Margin="0,3,0,14"/>

      <StackPanel><TextBlock x:Name="MemorySummary" Text="No learned selections yet" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button Content="Forget learned choices" Click="ForgetTargets" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,8"/></StackPanel>

      <TextBlock x:Name="TargetStatus" Text="Target assist is off." Style="{StaticResource Caption}" Margin="0,16,0,0"/>

      <TextBlock Text="Works with accessible controls in the active window. Some apps do not expose targets. Assistance is disabled while dragging and never starts movement on its own." Style="{StaticResource Caption}" Margin="0,10,0,0"/>

     </StackPanel></Border></Grid>

    </StackPanel></ScrollViewer>

   </TabItem>

