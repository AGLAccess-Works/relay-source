       <Expander Header="Saved Adaptive accessories" Visibility="{Binding Visibility, ElementName=AccessoryPanel}" Margin="0,12,0,0"><StackPanel x:Name="AccessoryPanel" Visibility="Collapsed"><TextBlock x:Name="AccessorySummary" TextWrapping="Wrap" AutomationProperties.AutomationId="SavedAdaptiveAccessorySetup"/><TextBlock Text="Saved setup; physical plug detection is unavailable." Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="Identify or name an accessory" Click="OpenAccessories" AutomationProperties.Name="Set up Adaptive Controller accessories" HorizontalAlignment="Left"/></StackPanel></Expander>
       <Expander Header="Setup options" Margin="0,12,0,0"><WrapPanel><Button Content="Choose a profile" Tag="8" Click="Navigate" Margin="0,0,10,10"/><Button Content="Hardware and accessories" Tag="9" Click="Navigate" Margin="0,0,0,10"/></WrapPanel></Expander>
       <Expander Header="All current button actions" Margin="0,12,0,0"><StackPanel x:Name="MappingSummary"/></Expander>
