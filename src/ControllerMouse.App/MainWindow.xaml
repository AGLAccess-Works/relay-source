        <StackPanel x:Name="ControlVisualPane"><WrapPanel x:Name="ControlViewsHost" Margin="0,0,0,8"/><StackPanel x:Name="ControlSimpleHost" Visibility="Collapsed"/><local:NavigationGroupPresenter AutomationProperties.Name="Controller inputs"><local:ControllerSurface x:Name="LiveSurface" MinHeight="390" AutomationProperties.Name="Live controller inputs"/></local:NavigationGroupPresenter><TextBlock x:Name="PreviewCaption" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
